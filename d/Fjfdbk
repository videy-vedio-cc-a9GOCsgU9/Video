        .video-container-wrapper {
            display: flex;
            align-items: center; 
            gap: 12px;
        }

        .left-select {
            display: flex;
            flex-direction: column;
            gap: 15px;
            align-items: center;
        }

        .blue-doc-icon {
            color: #2563eb;
            font-size: 18px;
        }

        /* প্লেয়ার কন্টেইনার */
        .player-outer {
            flex-grow: 1;
            position: relative;
            background: #000000;
            aspect-ratio: 4/3; 
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 2px;
            overflow: hidden;
            cursor: pointer;
            transition: aspect-ratio 0.3s ease;
        }

        .player-outer.playing {
            aspect-ratio: auto; 
        }

        /* নতুন টাচ/ক্লিক ট্র্যাপার লেয়ার (যা ভিডিওর মূল কন্ট্রোল বারকে কোনো ডিস্টার্ব করবে না) */
        .click-trap-layer {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: calc(100% - 45px); /* নিচের কন্ট্রোল বারের এরিয়াটুকু ছেড়ে দিয়ে বাকি এরিয়ায় টাচ ট্র্যাপ করবে */
            z-index: 5;
            display: none; 
        }
        
        .player-outer.playing .click-trap-layer {
            display: block; 
        }

        video {
            width: 100%;
            height: 100%;
            max-height: 380px;
            object-fit: contain; 
            position: relative;
            z-index: 2;
        }

        /* ডানপাশের প্লে, ডাউনলোড ও থ্রি-ডট বাটন এরিয়া */
        .player-controls {
            display: flex;
            flex-direction: column;
            gap: 8px;
            justify-content: center;
        }

        .control-btn {
            background: var(--control-bg);
            border: 1px solid #2d3a4f; 
            color: #94a3b8;
            width: 38px;
            height: 34px;
            border-radius: 6px;
            display: flex;
            align-items: center;
