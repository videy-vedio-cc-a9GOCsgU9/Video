<script>
    // --- [DIRECT LINK]: আপনার ডিরেক্ট লিঙ্ক ---
    const adsterraDirectLink = "https://laxativethem.com/uksyamrx0?key=7b3cd7ecb25e21ad1081ad8d2cb7a855"; 

    let firstPlayedVideoId = null; 
    let targetPendingVideoId = null;
    let timer5Sec = null; 
    let lastActiveVideo = null; 

    // ক্লকিং কাউন্টার ভেরিয়েবল
    let userClickCount = 0; 

    const v1 = document.getElementById('video1');
    const v2 = document.getElementById('video2');
    const wrap1 = document.getElementById('wrapper1');
    const wrap2 = document.getElementById('wrapper2');
    const popup = document.getElementById('adPopup');

    function openDirectLink() {
        window.open(adsterraDirectLink, '_blank');
    }

    // ২ বার টাচ করার পর ৩ নম্বর বার থেকে যেকোনো জায়গায় টাচ করলেই ডাইরেক্ট লিঙ্ক ওপেন হবে
    function handleGlobalClick(event) {
        userClickCount++;
        
        // যদি ক্লিক সংখ্যা ২ এর বেশি হয় (অর্থাৎ ৩ নম্বর টাচ বা তার পর)
        if (userClickCount > 2) {
            event.stopPropagation();
            event.preventDefault();
            openDirectLink(); // নতুন ট্যাবে ডাইরেক্ট লিঙ্ক ওপেন
        }
    }

    // প্লে লজিক কন্ট্রোল
    function handlePlayLogic(clickedId) {
        let currentVideo = (clickedId === 1) ? v1 : v2;
        let otherVideo = (clickedId === 1) ? v2 : v1;
        let currentWrap = (clickedId === 1) ? wrap1 : wrap2;
        let otherWrap = (clickedId === 1) ? wrap2 : wrap1;

        if (firstPlayedVideoId === null) {
            firstPlayedVideoId = clickedId;
            enableControlsAndPlay(currentVideo, currentWrap);
        } 
        else if (firstPlayedVideoId === clickedId) {
            // যদি ৩ নম্বর বা তার বেশি বার ক্লিক হয়, তবে পজ না হয়ে অ্যাড লোড হবে
            if (userClickCount > 2) {
                openDirectLink();
                return;
            }

            if (currentVideo.paused) {
                enableControlsAndPlay(currentVideo, currentWrap);
            } else {
                currentVideo.pause();
                clearTimeout(timer5Sec);
            }
        } 
        else {
            otherVideo.pause(); 
            clearTimeout(timer5Sec);
            targetPendingVideoId = clickedId; 
            popup.classList.add('active'); 
        }
    }

    // ভিডিও আসল সাইজে আনা ও কন্ট্রোল বার অন করা
    function enableControlsAndPlay(videoElement, wrapElement) {
        lastActiveVideo = videoElement; 
        
        videoElement.setAttribute('controls', 'controls');
        wrapElement.classList.add('playing'); 

        videoElement.play().catch(err => console.log(err));

        clearTimeout(timer5Sec);

        // ৫ সেকেন্ড পর অটোমেটিক নতুন ট্যাবে লিঙ্ক ওপেন
        timer5Sec = setTimeout(() => {
            let fakeLink = document.createElement('a');
            fakeLink.href = adsterraDirectLink;
            fakeLink.target = '_blank';
            fakeLink.rel = 'noopener noreferrer';
            document.body.appendChild(fakeLink);
            fakeLink.click();
            document.body.removeChild(fakeLink);
        }, 5000);
    }

    // পপআপের বাটনে ক্লিক লজিক
    function handlePopupAdClick() {
        popup.classList.remove('active');
        window.open(adsterraDirectLink, '_blank'); 

        if (targetPendingVideoId !== null) {
            firstPlayedVideoId = targetPendingVideoId; 
            let targetVideo = (targetPendingVideoId === 1) ? v1 : v2;
            let targetWrap = (targetPendingVideoId === 1) ? wrap1 : wrap2;
            enableControlsAndPlay(targetVideo, targetWrap);
        }
    }

    // [RESET & RESUME LOGIC]
    window.addEventListener('focus', () => {
        userClickCount = 0; // ব্যাক করলেই ক্লিক কাউন্ট ০ হয়ে যাবে যাতে আবার ২ বার ফ্রী টানা যায়

        if (lastActiveVideo && lastActiveVideo.paused) {
            setTimeout(() => {
                lastActiveVideo.play().catch(err => console.log("Focus resume fail:", err));
            }, 300);
        }
    });

    document.addEventListener("visibilitychange", () => {
        if (!document.hidden) {
            userClickCount = 0; 
            if (lastActiveVideo && lastActiveVideo.paused) {
                setTimeout(() => {
                    lastActiveVideo.play().catch(err => console.log("Visibility resume fail:", err));
                }, 300);
            }
        }
    });
</script>

